# Byte-compiled / packaging files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# Environments & Lockfiles
.venv/
env/
venv/
.python-version
pyproject.toml
uv.lock

# IDEs & OS generated files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
*.log
tmp_output*.txt

# --- Thesis Specific Rules ---

# Ignore heavy raw audit dumps and checkpoint folders locally (keep on disk, do not track in Git)
reports/audit_report_*.json
reports/protected_bias_audit_*.json
reports/partial_audit_results*
scratch/

# Ignore manuscript & thesis latex source directories & working notes
siuethesis/
MDPI___A_Comparative_Analysis_of_Implicit_Bias_and_Logical_Inconsistency_in_General_Purpose_and_Code_Specialized_Large_Language_Models/
reports/manuscript_notes/

# Whitelist core files and documentation
!README.md
!LICENSE
!Dockerfile
!docker-compose.yml
!requirements.txt
!.dockerignore
!.env
!auto_canonical_map.json
!project_log.md

# Whitelist core data files
!data/
!data/dataset/
!data/dataset/*
!data/ground_truth_benchmark.json
!data/ground_truth_benchmark.py
!data/generated_functions_grok/
!data/generated_functions_grok/*
!data/generated_functions_unified_new/
!data/generated_functions_unified_new/*
!data/generated_functions_old/
!data/generated_functions_old/*
!data/generated_functions_expanded/
!data/generated_functions_expanded/*

# Whitelist source code
!src/
!src/*.py
!tests/
!tests/*.py

# Whitelist summary reports and figures
!reports/
!reports/*.json
!reports/*.md
!reports/*.png
!reports/*.csv
!reports/figures/
!reports/figures/*
